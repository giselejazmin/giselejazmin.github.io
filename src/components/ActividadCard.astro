---
import type { IActividad } from "@datatypes/datatypes";
import { formatFechaLarga } from "@datatypes/utils";

interface Props {
  actividad: IActividad;
}

const { actividad } = Astro.props;
---

<article class="actividad-card">
  <div class="actividad-top">
    <span class:list={["badge-tipo", actividad.tipo === "noticia" ? "tipo-noticia" : "tipo-actividad"]}>
      {actividad.tipo === "noticia" ? "Noticia" : "Actividad"}
    </span>
    <time class="actividad-fecha" datetime={actividad.fecha}>
      {formatFechaLarga(actividad.fecha)}
    </time>
  </div>
  <h2 class="actividad-titulo">{actividad.titulo}</h2>
  <p class="actividad-descripcion">{actividad.descripcion}</p>
  {actividad.lugar && (
    <p class="actividad-lugar">
      <span class="lugar-label">Lugar:</span> {actividad.lugar}
    </p>
  )}
</article>

<style>
  .actividad-card {
    background-color: var(--white);
    border: 1px solid var(--iron-200);
    border-radius: 8px;
    padding: var(--gap-md);
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
  }
  .actividad-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .badge-tipo {
    font-size: var(--text-12);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .tipo-actividad {
    background-color: var(--green-100);
    color: var(--green-900);
  }
  .tipo-noticia {
    background-color: #e3ecf7;
    color: #2b4a73;
  }
  .actividad-fecha {
    font-size: var(--text-12);
    color: var(--iron-600);
    margin-left: auto;
  }
  .actividad-titulo {
    font-size: var(--text-18);
    color: var(--green-900);
    line-height: 1.3;
  }
  .actividad-descripcion {
    font-size: var(--text-14);
    color: var(--iron-700);
    line-height: 1.5;
  }
  .actividad-lugar {
    font-size: var(--text-14);
    color: var(--iron-800);
    margin-top: auto;
  }
  .lugar-label {
    color: var(--green-700);
    font-weight: 700;
  }
</style>
